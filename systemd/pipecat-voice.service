[Unit]
Description=Pipecat standalone voice router
Documentation=file:/home/bot/pipecat-voice-router/voice-router-pipecat-standalone/README.md
After=pig-io.service llama-server.service pipewire.service pipewire-pulse.service network-online.target
Wants=pig-io.service pipewire.service pipewire-pulse.service
PartOf=voice-stack.target

[Service]
Type=simple
WorkingDirectory=/home/bot/pipecat-voice-router/voice-router-pipecat-standalone
Environment=HOME=/home/bot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=VOICE_ROUTER_TTS_SPEED=1.1
Environment=VOICE_ROUTER_TTS_KEEP_LEADING_MS=40
Environment=VOICE_ROUTER_TTS_KEEP_TRAILING_MS=100
Environment=VOICE_ROUTER_VAD_MIN_VOLUME=0.006
Environment=VOICE_ROUTER_MOONSHINE_MODEL=small-streaming
Environment=VOICE_ROUTER_BARGE_MIN_VAD_SECS=0.55
Environment=VOICE_ROUTER_BARGE_MIN_RMS=0.04
Environment=FRONTIER_THINKING_REPEAT=0
ExecStartPre=-/home/bot/pipecat-voice-router/voice-router-pipecat-standalone/.venv/bin/python pulse_aec.py cleanup
ExecStart=/home/bot/pipecat-voice-router/voice-router-pipecat-standalone/.venv/bin/python app.py
ExecStartPost=/home/bot/pipecat-voice-router/voice-router-pipecat/voice_status.py enabled on
ExecStartPost=/home/bot/pipecat-voice-router/voice-router-pipecat/voice_status.py mode idle
ExecStopPost=-/home/bot/pipecat-voice-router/voice-router-pipecat-standalone/.venv/bin/python pulse_aec.py cleanup
ExecStopPost=/home/bot/pipecat-voice-router/voice-router-pipecat/voice_status.py enabled off
TimeoutStopSec=15
KillSignal=SIGINT
KillMode=mixed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
